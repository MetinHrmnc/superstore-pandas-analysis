   "source": [
    "Monthly=df.groupby(df[\"YearMonth\"]).agg(\n",
    "    Monthly_Sales=(\"Sales\",\"sum\"),\n",
    "    Monthly_Profit=(\"Profit\",\"sum\")\n",
    ").round(2)\n",
    "\n",
    "Monthly[\"Cumulative_Sales\"]=Monthly[\"Monthly_Sales\"].cumsum()\n",
    "\n",
    "Monthly[\"MA_3Month_Sales\"]=Monthly[\"Monthly_Sales\"].rolling(window=3).mean().round(2)\n",
    "\n",
    "Monthly[\"Previously_Month_Sales\"]=Monthly[\"Monthly_Sales\"].shift(1)\n",
    "\n",
    "Monthly[\"MoM%_Changes\"]=Monthly[\"Monthly_Sales\"]-Monthly[\"Previously_Month_Sales\"]/Monthly[\"Previously_Month_Sales\"].round(2)*100\n",
    " \n",
    "Monthly.head(15)"
   ]
  },
